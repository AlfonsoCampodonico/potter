            "exclude": [],
            "dest": "/app",
            "owner": "0:0"
          },
          {
            "kind": "run",
            "name": "deps",
            "command": {
              "shell": "composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress"
            },
            "env": {
              "COMPOSER_ALLOW_SUPERUSER": "1",
              "COMPOSER_CACHE_DIR": "/cache/composer"
            },
            "workdir": "/app",
            "user": "root",
            "network": true,
            "cache_mounts": [
              {
                "id": "composer",
                "target": "/cache/composer",
                "sharing": "exclusive"
              }
            ],
            "secrets": []
          },
          {
            "kind": "inputs",
            "name": "node-deps-inputs",
            "include": [
              "package.json",
