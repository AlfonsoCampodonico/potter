            "command": {
              "shell": "composer dump-autoload --optimize --no-dev --no-interaction --no-scripts"
            },
            "env": {
              "COMPOSER_ALLOW_SUPERUSER": "1"
            },
            "workdir": "/app",
            "user": "root",
            "network": true,
