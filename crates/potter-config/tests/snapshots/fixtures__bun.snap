---
source: crates/potter-config/tests/fixtures.rs
expression: "render(\"bun\")"
---
{
  "schema": "potter.plan/v1",
  "targets": [
    {
      "name": "app",
      "root": ".",
      "provider": "bun",
      "build": {
        "base": {
          "kind": "catalog",
          "layers": [
            {
              "name": "os-min"
            },
            {
              "name": "bun",
              "version": "1"
            }
          ]
        },
        "steps": [
          {
            "kind": "inputs",
            "name": "deps-inputs",
            "include": [
              "package.json",
              "bun.lock",
              "bunfig.toml"
            ],
            "exclude": [],
            "dest": "/app",
            "owner": "0:0"
          },
          {
            "kind": "run",
            "name": "deps",
            "command": {
              "argv": [
                "bun",
                "install",
                "--frozen-lockfile"
              ]
            },
            "env": {
              "BUN_INSTALL_CACHE_DIR": "/cache/bun"
            },
            "workdir": "/app",
            "user": "root",
            "network": true,
            "cache_mounts": [
              {
                "id": "bun",
                "target": "/cache/bun",
                "sharing": "exclusive"
              }
            ],
            "secrets": []
          },
          {
            "kind": "inputs",
            "name": "source",
            "include": [
              "**"
            ],
            "exclude": [],
            "dest": "/app",
            "owner": "0:0"
          },
          {
            "kind": "run",
            "name": "build",
            "command": {
              "argv": [
                "bun",
                "run",
                "build"
              ]
            },
            "env": {},
            "workdir": "/app",
            "user": "root",
            "network": true,
            "cache_mounts": [],
            "secrets": []
          }
        ]
      },
      "image": {
        "base": {
          "kind": "catalog",
          "layers": [
            {
              "name": "os-min"
            },
            {
              "name": "bun",
              "version": "1"
            }
          ]
        },
        "runtime_steps": [],
        "export": [
          {
            "path": "/app",
            "dest": "/app",
            "exclude": []
          }
        ],
        "files": [],
        "config": {
          "env": {
            "NODE_ENV": "production",
            "PORT": "3000"
          },
          "workdir": "/app",
          "user": "root",
          "labels": {},
          "port": 3000
        },
        "processes": {
          "web": {
            "command": [
              "bun",
              "run",
              "start"
            ],
            "env": {}
          }
        },
        "services": {}
      }
    }
  ]
}

# decisions
app provider = bun [detected: package.json; bun.lock]
app node.package_manager = bun [detected: bun.lock is present]
app runtime.bun = 1 [default]
app process.web = start script [detected: package.json scripts.start]
app port = 3000 [default]
