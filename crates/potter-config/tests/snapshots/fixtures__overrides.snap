# decisions
app provider = laravel [detected: composer.json requires laravel/framework; artisan]
app runtime.php = 8.3 [potter.toml target.app.runtime.php]
app runtime.extensions = bcmath [detected: Laravel default extension]
app runtime.extensions = imagick [potter.toml target.app.runtime.extensions]
app runtime.extensions = intl [detected: Laravel default extension]
app runtime.extensions = pcntl [detected: Laravel default extension]
app runtime.extensions = pdo_mysql [detected: Laravel default extension]
app runtime.extensions = pdo_pgsql [detected: Laravel default extension]
app runtime.extensions = redis [detected: Laravel default extension]
app php.docroot = public [detected: public/ exists]
app port = 8080 [default]
app node.package_manager = npm [detected: package-lock.json is present]
app runtime.node = 22 [default]
app process.worker = php artisan queue:work [detected: Laravel queue worker]
app steps.assets.command = npm run build:prod [potter.toml target.app.steps.assets.run]
app steps.assets.inputs = resources/** vite.config.js package.json [potter.toml target.app.steps.assets.inputs]
app steps.discover = skipped [potter.toml target.app.steps.discover.skip]
app steps.warm = php artisan icons:cache [potter.toml target.app.steps.warm]
app process.web = php artisan serve --host=0.0.0.0 --port=8080 [potter.toml target.app.process.web.cmd]
app steps.user-build-1 = php artisan route:list [potter.toml target.app.build.commands]
app process.deploy = php artisan migrate --force && php artisan config:cache [potter.toml target.app.deploy.commands]
app steps.apt-build = libvips-dev [potter.toml apt.build]
app runtime_steps.apt-runtime = libvips42 [potter.toml apt.runtime]
