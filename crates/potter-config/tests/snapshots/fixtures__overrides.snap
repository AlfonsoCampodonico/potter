{
  "schema": "potter.plan/v1",
  "targets": [
    {
      "name": "app",
      "root": ".",
      "provider": "laravel",
      "build": {
        "base": {
          "kind": "catalog",
          "layers": [
            {
              "name": "os-min"
            },
            {
              "name": "php",
              "version": "8.3"
            },
            {
              "name": "php-ext-bcmath",
              "version": "8.3"
            },
            {
              "name": "php-ext-imagick",
              "version": "8.3"
            },
            {
              "name": "php-ext-intl",
              "version": "8.3"
            },
            {
              "name": "php-ext-pcntl",
              "version": "8.3"
            },
            {
              "name": "php-ext-pdo_mysql",
              "version": "8.3"
            },
            {
              "name": "php-ext-pdo_pgsql",
              "version": "8.3"
            },
            {
              "name": "php-ext-redis",
              "version": "8.3"
            },
            {
              "name": "composer",
              "version": "2"
            },
            {
              "name": "node",
              "version": "22"
            }
          ]
        },
        "steps": [
          {
            "kind": "apt",
            "name": "apt-build",
            "packages": [
              "libvips-dev"
            ],
            "snapshot": "20261001T000000Z"
          },
          {
            "kind": "inputs",
            "name": "deps-inputs",
            "include": [
              "composer.json",
              "composer.lock"
            ],
            "exclude": [],
            "dest": "/app",
            "owner": "0:0"
          },
          {
            "kind": "run",
            "name": "deps",
            "command": {
              "shell": "composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress"
            },
            "env": {
              "COMPOSER_ALLOW_SUPERUSER": "1",
              "COMPOSER_CACHE_DIR": "/cache/composer"
            },
            "workdir": "/app",
            "user": "root",
            "network": true,
            "cache_mounts": [
              {
                "id": "composer",
                "target": "/cache/composer",
                "sharing": "exclusive"
              }
            ],
            "secrets": []
          },
          {
            "kind": "inputs",
            "name": "node-deps-inputs",
            "include": [
              "package.json",
              "package-lock.json"
            ],
            "exclude": [],
            "dest": "/app",
            "owner": "0:0"
          },
          {
            "kind": "run",
            "name": "node-deps",
            "command": {
              "argv": [
                "npm",
                "ci",
                "--no-audit",
                "--no-fund"
              ]
            },
            "env": {
              "npm_config_cache": "/cache/npm"
            },
            "workdir": "/app",
            "user": "root",
            "network": true,
            "cache_mounts": [
              {
                "id": "npm",
                "target": "/cache/npm",
                "sharing": "exclusive"
              }
            ],
            "secrets": []
          },
          {
            "kind": "inputs",
            "name": "source",
            "include": [
              "**"
            ],
            "exclude": [],
            "dest": "/app",
            "owner": "0:0"
          },
          {
            "kind": "inputs",
            "name": "assets-inputs",
            "include": [
              "resources/**",
              "vite.config.js",
              "package.json"
            ],
            "exclude": [],
            "dest": "/app",
            "owner": "0:0"
          },
          {
            "kind": "run",
            "name": "assets",
            "command": {
              "shell": "npm run build:prod"
            },
            "env": {},
            "workdir": "/app",
            "user": "root",
            "network": true,
            "cache_mounts": [],
            "secrets": []
          },
          {
            "kind": "run",
            "name": "autoload",
            "command": {
              "shell": "composer dump-autoload --optimize --no-dev --no-interaction --no-scripts"
            },
            "env": {
              "COMPOSER_ALLOW_SUPERUSER": "1"
            },
            "workdir": "/app",
            "user": "root",
            "network": true,
            "cache_mounts": [],
            "secrets": []
          },
          {
            "kind": "run",
            "name": "warm",
            "command": {
              "shell": "php artisan icons:cache"
            },
            "env": {},
            "workdir": "/app",
            "user": "root",
            "network": true,
            "cache_mounts": [],
            "secrets": []
          },
          {
